include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md llms.txt agent-contract.json
recursive-include docs *.md
recursive-include examples *.json *.txt
recursive-include schemas *.json
recursive-include tests *.py
recursive-include scripts *.py
prune exports
prune private-validation
prune .cache
global-exclude *.py[cod]
