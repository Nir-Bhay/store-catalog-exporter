{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Store Catalog Exporter configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "csv_columns": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "include_handles": {"type": "array", "items": {"type": "string"}},
    "exclude_handles": {"type": "array", "items": {"type": "string"}},
    "exclude_tags": {"type": "array", "items": {"type": "string"}},
    "overrides": {"type": "object", "additionalProperties": false, "properties": {"vendor": {"type": "string"}}}
  }
}
